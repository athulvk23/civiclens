# CivicLens — Server-Side Configuration
# Copy this file to .env and fill in your credentials.
# Never expose GEMINI_API_KEY or SUPABASE_SERVICE_ROLE_KEY in frontend VITE_* variables.

# Vision-capable Gemini API Key (uses gemini-3.8-flash via @google/genai SDK on the server)
# If omitted, CivicLens runs in a clearly disclosed Heuristic Demo Mode.
GEMINI_API_KEY=

# Optional Supabase Persistence (Server-Side)
# If omitted, CivicLens persists data locally in server/data/store.json and clearly labels storage mode.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Demo Region Name
DEMO_REGION=Chennai, Tamil Nadu (Anna Salai / T. Nagar / Mylapore / Adyar)
